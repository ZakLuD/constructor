# This file mirrors .env.example for environments that expect ENV.example.

NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
WEB_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

DATABASE_URL=postgresql://sitebuilder:sitebuilder@localhost:5432/sitebuilder?schema=public

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
PASSWORD_PEPPER=replace-with-another-secret

ALLOWED_ORIGINS=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/oauth/callback

LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

DISABLE_TELEMETRY=true
DISABLE_ANALYTICS=true
